# Admin login (single admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the admin session cookie. Long random string.
SESSION_SECRET=

# Backend URL for server-side calls (the /api/backend proxy and server components).
# Production: https://api.rizzleather.com/api
BACKEND_URL=http://localhost:3040/api

# Shared secret sent to the backend as `x-admin-key`. Server-only — never prefix
# with NEXT_PUBLIC_. Must equal ADMIN_API_KEY in the backend's .env (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Still read as a fallback for BACKEND_URL. The browser no longer calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:3040/api

# AI content generation
ANTHROPIC_API_KEY=
